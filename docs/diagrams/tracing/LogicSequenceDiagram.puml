@startuml
!include ../style.puml
skinparam ArrowFontStyle plain
hide footbox

Participant ":EditCommandParser" as ecp LOGIC_COLOR
Participant ":IndexRangeParser" as irp LOGIC_COLOR
Participant "command:EditCommand" as ec LOGIC_COLOR

[-> ecp ++: parse(arguments)
ecp -> irp ++: parse(preamble)
irp --> ecp --: ranges
ecp -> ecp : validate input and build descriptor

note right of ecp
  Multiple selections allow only
  subject, group, and tags.
end note

create ec
ecp -> ec : new EditCommand(...)

[<-- ecp --: command

@enduml
