@startuml
!include style.puml
skinparam ArrowFontStyle plain
hide footbox

box Logic LOGIC_COLOR_T1
participant "command:EditCommand" as EditCommand LOGIC_COLOR
participant "target:IndexPersonTarget" as IndexPersonTarget LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "model:Model" as Model MODEL_COLOR
end box

[-> EditCommand ++: execute(model)
EditCommand -> IndexPersonTarget ++: resolve(model)
IndexPersonTarget -> Model ++: getFilteredPersonList()
Model --> IndexPersonTarget --: displayedPeople
note right of IndexPersonTarget
  Validate all indexes before
  returning any students.
end note
IndexPersonTarget --> EditCommand --: peopleToEdit

loop prepare each replacement
    EditCommand -> EditCommand : createEditedPerson(person, descriptor)
end

EditCommand -> Model ++: setPersonsInBatch(peopleToEdit, editedPeople)
deactivate Model

[<-- EditCommand --: CommandResult
@enduml
